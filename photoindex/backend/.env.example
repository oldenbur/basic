# Copy to .env and fill in. Never commit .env.

# Dropbox app (https://www.dropbox.com/developers/apps): scoped access, "Full Dropbox" or an App folder,
# permissions files.metadata.read + files.content.read. Then run `uv run photoindex dropbox-auth`.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
PHOTO_ROOT=/Photos

# Laptop defaults (SeaweedFS from deploy/docker-compose.dev.yml). For Cloudflare R2 instead:
#   S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com  S3_ACCESS_KEY=...  S3_SECRET_KEY=...
#   PUBLIC_IMAGE_BASE=https://images.example.com   (optional R2 custom domain; otherwise presigned URLs)
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=photoindex

# To try everything without Dropbox, point at a local folder laid out like the library:
# SOURCE=local
# PHOTO_ROOT=/Users/you/Pictures/sample-library
